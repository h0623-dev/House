{
  "name": "road-haven",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "android:sync": "npm run build && cap sync android",
    "test:browser": "node tests/browser-smoke.mjs",
    "android:debug": "bash scripts/build-android.sh debug",
    "android:release": "bash scripts/build-android.sh release",
    "test:mobile": "node tests/mobile-touch-real-time.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/noto-sans-kr": "^5.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@playwright/test": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
